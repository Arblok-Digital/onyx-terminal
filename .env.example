# === Jupiter Proxy URL ===
VITE_JUP_PROXY_URL=http://localhost:3001
JUPITER_API_KEY=YOUR_JUPITER_API_KEY

# === 9Router Gateway (Primary AI) ===
VITE_AI_GATEWAY_URL=http://localhost:20128/v1
VITE_AI_GATEWAY_KEY=arblok

# === OpenRouter (Fallback AI - Free Models) ===
VITE_OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
VITE_OPENROUTER_ENABLED=true
VITE_OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions

# === Arkham Intelligence (On-Chain Intel & WebSocket) ===
VITE_ARKHAM_API_KEY=YOUR_ARKHAM_API_KEY
VITE_ARKHAM_WS_URL=wss://api.arkhamintelligence.com/ws

# === Alternative Free Tier RPCs ===

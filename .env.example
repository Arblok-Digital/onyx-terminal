# =============================================================
# ONYX TERMINAL — Environment Variables Example
# Copy to .env (local dev) or set in Vercel dashboard (production)
# =============================================================
#
# 🔒 SECURITY (PENTING):
#   Server-side keys (NVIDIA/HELIUS/OPENROUTER/JUPITER_API_KEY) → selalu tanpa VITE_ prefix
#   VITE_ prefix = di-bake ke JS bundle → JANGAN set di Vercel production
#
#   Yang pakai VITE_ (aman di client):
#     - Fee accounts ATA (public addresses)
#     - Supabase URL/anon key (public)
#     - Solana program ID (public)
#     - Network selection
#     - Jupiter proxy URL (public endpoint)

# === Jupiter Proxy URL ===
VITE_JUP_PROXY_URL=http://localhost:3001

# === Jupiter API (server-side — dibaca api/jup/*) ===
JUPITER_API_KEY=YOUR_JUPITER_API_KEY

# === Jupiter Fee Accounts (CLIENT-SIDE — AMAN di-expose ke browser) ===
# Alamat ATA public. Browser butuh tau ini buat inject feeAccount ke swap.
VITE_JUPITER_FEE_ACCOUNT_WSOL=YOUR_WSOL_FEE_ACCOUNT_ATA
VITE_JUPITER_FEE_ACCOUNT_USDC=YOUR_USDC_FEE_ACCOUNT_ATA
VITE_JUPITER_REFERRAL_WALLET=

# === 9Router Gateway ===
# Dipakai server-side oleh proxy /api/ai/agent
# Set LOCAL url di VITE_; key tanpa prefix karena cuma dibaca server
VITE_AI_GATEWAY_URL=http://localhost:20128/v1
VITE_AI_GATEWAY_KEY=YOUR_9ROUTER_KEY

# === AI Providers (SERVER-SIDE — dibaca /api/ai/agent) ===
# Set di Vercel dashboard tanpa VITE_ prefix.
# NVIDIA primary, OpenRouter fallback, 9Router terakhir.
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY
VITE_NVIDIA_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
VITE_OPENROUTER_ENABLED=true
VITE_OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions

# === Data Sources / RPC (SERVER-SIDE) ===
# Helius key dibaca proxy /api/rpc; jangan expose ke client.
HELIUS_API_KEY=YOUR_HELIUS_API_KEY
BIRDEYE_API_KEY=YOUR_BIRDEYE_API_KEY

# === Solana Network (CLIENT-SIDE — AMAN) ===
VITE_SOLANA_NETWORK=mainnet-beta
VITE_SOLANA_RPC=https://api.mainnet-beta.solana.com
VITE_DEVNET_RPC=https://api.devnet.solana.com

# === Onyx Program (CLIENT-SIDE — AMAN) ===
VITE_ONYX_PROGRAM_ID=FjMdzw1x2zobB9UD8pcezbmzLwuHQnKMzit68Zbx87PG

# === Supabase (CLIENT-SIDE — anon key AMAN, gak expose service_role!) ===
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# =============================================================
# INSTRUKSI DEPLOY KE VERCEL
# =============================================================
#
# 1. Project Settings → Environment Variables
#
# 2. Production env vars (WAJIB):
#    - HELIUS_API_KEY
#    - NVIDIA_API_KEY
#    - OPENROUTER_API_KEY
#    - JUPITER_API_KEY
#    - VITE_JUPITER_FEE_ACCOUNT_WSOL
#    - VITE_JUPITER_FEE_ACCOUNT_USDC
#    - VITE_SOLANA_NETWORK=mainnet-beta
#    - VITE_ONYX_PROGRAM_ID
#
# 3. Production env vars (OPSIONAL):
#    - VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY (analytics)
#    - BIRDEYE_API_KEY (chart features)
#    - VITE_AI_GATEWAY_URL + VITE_AI_GATEWAY_KEY (9Router fallback)
#
# 4. JANGAN set VITE_HELIUS_API_KEY / VITE_NVIDIA_API_KEY / VITE_OPENROUTER_API_KEY
#    di production — bakal ke-bake ke bundle publik.
#
# 5. Setelah deploy pertama, cek browser bundle:
#    - Buka https://onyx-terminal.vercel.app
#    - DevTools → Sources → cari "HELIUS_API_KEY" / "nvapi-"
#    - HARUS gak ada di bundle client-side.
# =============================================================

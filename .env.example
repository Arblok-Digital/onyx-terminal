VITE_FREE_RPC_2=https://solana-mainnet.core.chainstack.com/YOUR_CHAINSTACK_API_KEY
VITE_FREE_RPC_3=https://solana-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# === Helius RPC ===

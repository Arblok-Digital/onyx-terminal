{
  "include": [
    "src/**/*",
    "intelligent_integration/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "compilerOptions": {
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2020",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node",
      "vite/client",
      "vitest/globals",
      "vite-plugin-pwa/client",
      "reflect-metadata"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@intelligent_integration": [
        "./intelligent_integration/index.ts"
      ],
      "@intelligent_integration/*": [
        "./intelligent_integration/*"
      ]
    }
  }
}